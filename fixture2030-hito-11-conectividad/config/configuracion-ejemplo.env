# =====================================================================
# Hito 11 - Configuración del diagnóstico de conectividad (ejemplo)
# =====================================================================
# El diagnóstico lee, de menor a mayor prioridad:
#   1. valores por defecto (los de este archivo, sin secretos);
#   2. ../fixture2030-hito-10-api-integrada/.env  (la misma configuración que la API);
#   3. config/conectividad.env  (opcional; copiar este archivo y editar);
#   4. variables de entorno     (para simular escenarios sin editar archivos).
# conectividad.env está excluido del repositorio. No escribir secretos acá.
#
# Valores para ejecutar DESDE LA NOTEBOOK contra el docker-compose.yml raíz.
# Desde un contenedor en la red de Compose: MONGO_HOST=mongodb,
# NEO4J_URI=bolt://neo4j:7687, CASSANDRA_HOSTS=cassandra, REDIS_HOST=redis,
# INFLUX_URL=http://influxdb:8181, IRIS_HOST=iris (ver scripts/evaluar_desde_red_docker.sh).
# =====================================================================

# --- API del Hito 10 ---
API_URL=http://127.0.0.1:8000
API_TIMEOUT_S=15
# Log de la API para asociar request IDs (relativo a esta carpeta)
API_LOG_FILE=../fixture2030-hito-10-api-integrada/logs/api.log

# --- Límites de espera (segundos) ---
# TCP_TIMEOUT_S > 2: en Windows un puerto cerrado en 127.0.0.1 tarda ~2 s en
# devolver "connection refused"; con menos se informaría como timeout.
TCP_TIMEOUT_S=3
TIMEOUT_CONEXION_S=2
TIMEOUT_OPERACION_S=5
# Una lectura más lenta que esto se marca como observación
UMBRAL_LENTO_MS=1000

# --- MongoDB (Hito 4) ---
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_USER=admin
MONGO_PASSWORD=<completar>
MONGO_AUTH_DB=admin
MONGO_DATABASE=fixture2030
MONGO_COLECCIONES=equipos,jugadores
MONGO_EQUIPO_PRUEBA=ARG

# --- Neo4j (Hito 5) ---
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_HTTP_URL=http://127.0.0.1:7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=<completar>
NEO4J_DATABASE=neo4j
NEO4J_PARTIDO_PRUEBA=P-001
NEO4J_PARTIDO_SIN_EVENTOS=P-002

# --- Cassandra (Hito 6) - sin autenticación en el laboratorio ---
CASSANDRA_HOSTS=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=fixture2030
CASSANDRA_DC=datacenter1
CASSANDRA_TABLA=comentarios_por_partido
CASSANDRA_PARTIDO_PRUEBA=P-001
CASSANDRA_VENTANA_PRUEBA=203006152015

# --- Redis (Hito 7) - sin contraseña en el laboratorio ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CLAVE_PRUEBA=sesion:S-0001
# 1 = escribe una clave diag:h11:* de 1,5 s para mostrar existente -> expirada
REDIS_SONDA_EXPIRACION=0

# --- InfluxDB 3 Core (Hito 8) ---
INFLUX_URL=http://127.0.0.1:8181
INFLUX_DATABASE=fixture2030
# Vacío: se lee INFLUX_TOKEN_FILE (generado por el Hito 8, excluido del repositorio)
INFLUX_TOKEN=
INFLUX_TOKEN_FILE=../fixture2030-influxDB/.influxdb3-token
INFLUX_TABLA=estadisticas_partido
INFLUX_PARTIDO_PRUEBA=P-001
INFLUX_DESDE=2030-06-10T20:00:00Z
INFLUX_HASTA=2030-06-10T20:15:00Z

# --- InterSystems IRIS (Hito 9) ---
IRIS_HOST=127.0.0.1
IRIS_PORT=1972
IRIS_PORTAL_URL=http://127.0.0.1:52773/csp/sys/UtilHome.csp
IRIS_NAMESPACE=USER
# Namespace donde se reintenta el login para separar "credencial" de "namespace"
IRIS_NAMESPACE_ALTERNATIVO=USER
IRIS_USER=fixture_api_read
IRIS_PASSWORD=<completar>
IRIS_CLASE=Fixture.Partido
IRIS_ACTA_PRUEBA=P-009

# --- Docker (solo para informar el estado de los contenedores) ---
DOCKER_PREFIJO=fixture2030-
