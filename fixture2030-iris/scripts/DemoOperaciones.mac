ROUTINE DemoOperaciones
#include %occStatus

    Write "==== Inicio de Demostración Operativa ====",!
    Write "1. Carga atómica de objetos y relaciones fuertes (RF6)",!
    
    // Instanciar Partido (Padre)
    Set partido = ##class(Fixture.Partido).%New()
    Set partido.Sede = "Estadio Centenario"
    Set partido.Fecha = $ZDATEH("2030-07-15", 3)
    Set partido.Estado = "En Juego"
    
    // Instanciar Eventos (Hijos)
    Set evento1 = ##class(Fixture.Evento).%New()
    Set evento1.Minuto = 12
    Set evento1.Tipo = "Gol"
    Set evento1.Descripcion = "Gol de Uruguay"
    Do partido.Eventos.Insert(evento1)
    
    Set evento2 = ##class(Fixture.Evento).%New()
    Set evento2.Minuto = 45
    Set evento2.Tipo = "Tarjeta Amarilla"
    Set evento2.Descripcion = "Falta fuerte"
    Do partido.Eventos.Insert(evento2)

    // Guardar Padre (guarda atómicamente a los hijos)
    Set status = partido.%Save()
    If $$$ISOK(status) {
        Write "Partido y Eventos guardados exitosamente. ID del Partido: ", partido.%Id(),!
    } Else {
        Write "Error al guardar: "
        Do $system.Status.DisplayError(status)
    }

    Write !, "2. Navegación por referencias sin SQL (RF7)",!
    Set idPartido = partido.%Id()
    
    // Abrir el objeto desde disco
    Set partidoDB = ##class(Fixture.Partido).%OpenId(idPartido)
    Write "Partido en ", partidoDB.Sede, " - Estado: ", partidoDB.Estado,!
    
    // Iterar la colección de hijos
    For i=1:1:partidoDB.Eventos.Count() {
        Set evento = partidoDB.Eventos.GetAt(i)
        Write " - Evento al minuto ", evento.Minuto, ": ", evento.Tipo, " (", evento.Descripcion, ")",!
    }
    
    Write !, "3. Demostración de Proyección Multimodelo SQL (RF8)",!
    Set sql = "SELECT ID, Minuto, Tipo, Descripcion, Partido FROM Fixture.Evento WHERE Partido = ?"
    Set rs = ##class(%ResultSet).%New("%DynamicQuery:SQL")
    Set status = rs.Prepare(sql)
    If $$$ISOK(status) {
        Set status = rs.Execute(idPartido)
        Write "Resultados de SQL para los Eventos del Partido ", idPartido, ":",!
        While rs.Next() {
            Write " - ID: ", rs.Get("ID"), " | Minuto: ", rs.Get("Minuto"), " | Tipo: ", rs.Get("Tipo"),!
        }
    } Else {
        Write "Error al preparar SQL: "
        Do $system.Status.DisplayError(status)
    }

    Write !, "4. Validación Encapsulada (%OnBeforeSave) (RF9)",!
    Set partidoDB.Estado = "Finalizado"
    Set status = partidoDB.%Save()
    
    Write "Intentando agregar un evento a un partido Finalizado...",!
    Set eventoInvalido = ##class(Fixture.Evento).%New()
    Set eventoInvalido.Minuto = 90
    Set eventoInvalido.Tipo = "Gol"
    Set eventoInvalido.Descripcion = "Gol fuera de tiempo"
    
    // Asignamos la relación al partido finalizado
    Set eventoInvalido.Partido = partidoDB
    Set status = eventoInvalido.%Save()
    
    If $$$ISERR(status) {
        Write "Validación exitosa, el guardado fue rechazado con el error: ",!
        Do $system.Status.DisplayError(status)
    } Else {
        Write "Error de implementación: El evento se guardó incorrectamente.",!
    }
    
    Write !, "==== Fin de la Demostración ====",!
