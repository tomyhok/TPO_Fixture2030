# =====================================================================
# Hito 10 - Configuración de la API (copiar a .env y completar)
# =====================================================================
# .env está excluido del repositorio. Los valores de este ejemplo
# corresponden a ejecutar la API desde la notebook contra el
# docker-compose.yml de la raíz. Las contraseñas NO se versionan:
# completarlas con las de su entorno local.

API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# Límites de espera (segundos) para conexión y para cada operación (RNF8)
TIMEOUT_CONEXION_S=2
TIMEOUT_OPERACION_S=5

# MongoDB (Hito 4)
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_USER=admin
MONGO_PASSWORD=<completar>
MONGO_AUTH_DB=admin
MONGO_DATABASE=fixture2030

# Neo4j (Hito 5)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<completar>
NEO4J_DATABASE=neo4j

# Cassandra (Hito 6) - sin autenticación en el laboratorio
CASSANDRA_HOSTS=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=fixture2030
CASSANDRA_DC=datacenter1

# Redis (Hito 7) - sin contraseña en el laboratorio
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# InfluxDB 3 Core (Hito 8)
INFLUX_URL=http://127.0.0.1:8181
INFLUX_DATABASE=fixture2030
# Dejar vacío para leer el token de fixture2030-influxDB/.influxdb3-token
INFLUX_TOKEN=

# InterSystems IRIS (Hito 9)
# scripts/preparar_datos.sh crea el usuario IRIS_USER con esta contraseña
# y el rol mínimo FixtureAPI. Elegir una contraseña propia.
IRIS_HOST=127.0.0.1
IRIS_PORT=1972
IRIS_NAMESPACE=USER
IRIS_USER=fixture_api
IRIS_PASSWORD=<completar>

# Reglas de negocio
CACHE_PARTIDO_TTL_S=300
IDEMPOTENCIA_TTL_S=86400
